# Yozigo Cinema Backend Configuration

# Database Connection (Default is SQLite, or set to PostgreSQL)
# Example PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/yozigo_db
DATABASE_URL=sqlite:///./yozigo.db

# JWT Authentication
JWT_SECRET_KEY=yozigo-super-secret-jwt-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Yozigo Cinema Backend Configuration

# Pooled Neon URL for the API (hostname includes -pooler). Direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (S3-compatible). Path-style addressing is required.
AWS_ENDPOINT_URL_S3=https://br-xxxxx.storage.c-6.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=uploads

# JWT Authentication
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional one-time admin seed settings. Never use these placeholder values.
ADMIN_EMAIL=admin@yozigo.com
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_FULL_NAME=Yozigo Admin
